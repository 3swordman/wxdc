{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortTailwindcss": { "stylesheet": "./src/style.css" },
  "ignorePatterns": [
    "backup/**",
    "dist/**",
    ".wrangler/**",
    "coverage/**",
    "node_modules/**",
    "package-lock.json",
    "pnpm-lock.yaml"
  ]
}
